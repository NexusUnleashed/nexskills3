{
  "name": "nexskills3",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "nexSkills pattern definitions for Achaea on the Nexus client.",
  "author": "Khaseem",
  "license": "ISC",
  "scripts": {
    "dev": "vite --config vite.config.site.js",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "build:site": "vite build --config vite.config.site.js",
    "preview": "vite preview --config vite.config.site.js",
    "predeploy": "npm run build:site",
    "deploy": "gh-pages -d build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "verify": "npm run lint && npm run test && npm run build && npm run build:site"
  },
  "dependencies": {
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@fontsource/roboto": "^5.0.13",
    "@mui/material": "^5.15.19",
    "@mui/x-tree-view": "^7.6.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/eslint-plugin": "^1.3.16",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "gh-pages": "^6.3.0",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "terser": "^5.48.0",
    "vite": "^7.2.6",
    "vitest": "^3.2.4"
  }
}
